rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Access Control Architecture
    // ===============================================================
    //
    // Collection: /users/{userId}
    //   - Profile information for registered users
    //
    // Collection: /game_definitions/{gameId}
    //   - Global read-only game catalog
    //
    // Top-Level Collections (direct root-level document access):
    //   - /timeline/{itemId}
    //   - /potluck/{itemId}
    //   - /rsvps/{rsvpId}
    //   - /attendance/{attendanceId}
    //   - /hostSchedule/{scheduleId}
    //   - /expenses/{expenseId}
    //   - /winners/{winnerId}
    //   - /prizes/{prizeId}
    //   - /contributions/{contributionId}
    //   - /memories/{memoryId}
    //   - /budgets/{eventId}
    //
    // Collection: /groups/{groupId}
    //   - Fields: ownerId, createdBy, memberIds (list), adminIds (list)
    //   - Subcollections:
    //     - /members/{memberId}
    //     - /join_requests/{requestId}
    //     - /host_schedules/{scheduleId}
    //     - /events/{eventId}
    //       - /rsvps/{rsvpId}
    //       - /attendance/{attendanceId}
    //       - /food_items/{itemId}
    //       - /timeline/{itemId}
    //     - /game_sessions/{sessionId}
    //       - /participants/{participantId}
    //       - /winners/{winnerId}
    //     - /contributions/{contributionId}
    //     - /expenses/{expenseId}
    //     - /memories/{memoryId}
    //
    // Top-Level / Collection Group Matching:
    //   - /{path=**}/invites/{inviteId}
    //
    // ===============================================================

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(groupId) {
      let groupPath = /databases/$(database)/documents/groups/$(groupId);
      let memberPath = /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
      return isSignedIn() && (
        (exists(groupPath) && (
          ('ownerId' in get(groupPath).data && get(groupPath).data.ownerId == request.auth.uid) ||
          ('createdBy' in get(groupPath).data && get(groupPath).data.createdBy == request.auth.uid) ||
          ('memberIds' in get(groupPath).data && get(groupPath).data.memberIds is list && request.auth.uid in get(groupPath).data.memberIds)
        )) ||
        exists(memberPath) ||
        (resource != null && 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        (resource != null && 'createdBy' in resource.data && resource.data.createdBy == request.auth.uid) ||
        (resource != null && 'memberIds' in resource.data && resource.data.memberIds is list && request.auth.uid in resource.data.memberIds)
      );
    }

    function isAdmin(groupId) {
      let groupPath = /databases/$(database)/documents/groups/$(groupId);
      let memberPath = /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
      return isSignedIn() && (
        (exists(groupPath) && (
          ('ownerId' in get(groupPath).data && get(groupPath).data.ownerId == request.auth.uid) ||
          ('createdBy' in get(groupPath).data && get(groupPath).data.createdBy == request.auth.uid) ||
          ('adminIds' in get(groupPath).data && get(groupPath).data.adminIds is list && request.auth.uid in get(groupPath).data.adminIds)
        )) ||
        (exists(memberPath) && 'role' in get(memberPath).data && get(memberPath).data.role in ['admin', 'owner']) ||
        (resource != null && 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        (resource != null && 'createdBy' in resource.data && resource.data.createdBy == request.auth.uid) ||
        (resource != null && 'adminIds' in resource.data && resource.data.adminIds is list && request.auth.uid in resource.data.adminIds)
      );
    }

    // Top-Level / Collection Group rules for Invites
    match /{path=**}/invites/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      allow delete: if isUser(userId);
    }

    // Game Catalog (Global definitions)
    match /game_definitions/{gameId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable by backend / admin
    }

    // Top-level rules for direct collection queries
    match /rsvps/{rsvpId} {
      allow read, write: if isSignedIn();
    }

    match /attendance/{attendanceId} {
      allow read, write: if isSignedIn();
    }

    match /timeline/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /potluck/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /hostSchedule/{scheduleId} {
      allow read, write: if isSignedIn();
    }

    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    match /budgets/{budgetId} {
      allow read, write: if isSignedIn();
    }

    match /winners/{winnerId} {
      allow read, write: if isSignedIn();
    }

    match /prizes/{prizeId} {
      allow read, write: if isSignedIn();
    }

    match /contributions/{contributionId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /memories/{memoryId} {
      allow read, write: if isSignedIn();
    }

    // Groups & Subcollections
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isMember(groupId);

      // Members
      match /members/{memberId} {
        allow read: if isSignedIn() && (isMember(groupId) || request.auth.uid == memberId);
        allow create, update: if isSignedIn() && (isMember(groupId) || request.auth.uid == memberId);
        allow delete: if isSignedIn() && (isAdmin(groupId) || request.auth.uid == memberId);
      }

      // Join Requests
      match /join_requests/{requestId} {
        allow read: if isSignedIn() && (isMember(groupId) || request.auth.uid == requestId);
        allow create: if isSignedIn() && request.auth.uid == requestId;
        allow update, delete: if isSignedIn() && (isAdmin(groupId) || request.auth.uid == requestId);
      }

      // Host Schedules
      match /host_schedules/{scheduleId} {
        allow read, write: if isSignedIn() && isMember(groupId);
      }

      // Events & Subcollections
      match /events/{eventId} {
        allow read, write: if isSignedIn() && isMember(groupId);

        match /rsvps/{rsvpId} {
          allow read, write: if isSignedIn() && isMember(groupId);
        }

        match /attendance/{attendanceId} {
          allow read, write: if isSignedIn() && isMember(groupId);
        }

        match /food_items/{itemId} {
          allow read, write: if isSignedIn() && isMember(groupId);
        }

        match /timeline/{itemId} {
          allow read, write: if isSignedIn() && isMember(groupId);
        }
      }

      // Game Sessions & Subcollections
      match /game_sessions/{sessionId} {
        allow read, write: if isSignedIn() && isMember(groupId);

        match /participants/{participantId} {
          allow read, write: if isSignedIn() && isMember(groupId);
        }

        match /winners/{winnerId} {
          allow read, write: if isSignedIn() && isMember(groupId);
        }
      }

      // Contributions
      match /contributions/{contributionId} {
        allow read, create, update, delete: if isSignedIn() && isMember(groupId);
      }

      // Expenses & Budgets
      match /expenses/{expenseId} {
        allow read, write: if isSignedIn() && isMember(groupId);
      }

      // Memories
      match /memories/{memoryId} {
        allow read, write: if isSignedIn() && isMember(groupId);
      }
    }
  }
}
